{
  "manifest_version": 3,
  "name": "e621 extras",
  "version": "1.5.5",
  "description": "Downvotes-to-blacklist manager, post tree viewer, hover zoom and tag scripts for regular members of e621 and e926.",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://*.e621.net/*",
    "https://*.e926.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "e621 extras"
  },
  "content_scripts": [
    {
      "matches": ["https://e621.net/*", "https://e926.net/*"],
      "css": ["styles/extras.css"],
      "js": [
        "scripts/constants.js",
        "scripts/core.js",
        "scripts/selectors.js",
        "scripts/utils.js",
        "scripts/net.js",
        "scripts/ui/dom.js",
        "scripts/ui/layout.js",
        "scripts/ui/thumbnail.js",
        "scripts/ui/dtext.js",
        "scripts/ui/tooltips.js",
        "scripts/blacklist.js",
        "scripts/uploader.js",
        "scripts/user_edits.js",
        "scripts/ai_heuristics.js",
        "scripts/tree/data.js",
        "scripts/tree/export.js",
        "scripts/tree/modal.js",
        "scripts/hover_zoom/data.js",
        "scripts/hover_zoom/index.js",
        "scripts/tag_script/engine.js",
        "scripts/tag_script/queue.js",
        "scripts/tag_script/timeouted_page.js",
        "scripts/tag_script/logger.js",
        "scripts/tag_script/storage.js",
        "scripts/tag_script/runner.js",
        "scripts/tag_script/preview.js",
        "scripts/tag_script/index.js",
        "scripts/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}